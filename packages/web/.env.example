# Platform API URL (public — safe for browser)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth token for local development ONLY
# This is server-side only (NOT NEXT_PUBLIC_). Used by Server Actions
# and API routes to authenticate with the platform backend.
# In production, this is replaced by an authenticated session mechanism.
AUTH_TOKEN=demo-token

# ---------------------------------------------------------------------------
# F-PR2 Data Mode (public — safe for browser)
# ---------------------------------------------------------------------------
# Resolves whether a workspace uses Demo providers (deterministic fixtures) or
# Live providers (platform wrappers). Values: demo | live | auto.
#   demo -> only the case matching NEXT_PUBLIC_DEMO_CASE_ID may use it; any
#           other case throws a config error (no silent fallback to mock).
#   live -> always live.
#   auto -> development only: demo for the matching demo case, otherwise live.
#           In production "auto" is treated as live.
NEXT_PUBLIC_DATA_MODE=auto

# The ONLY case that is allowed to resolve to Demo mode. This must equal the
# ?caseId= query parameter of the demo investigation route.
# Deterministic demo case id (Operation Financial Shadow):
NEXT_PUBLIC_DEMO_CASE_ID=b1e0c9a6-0000-4000-8000-000000000001

# Demo timing multiplier for simulated latency/realtime (positive number;
# default 1). NOTE: this is server-only (not NEXT_PUBLIC_) and is therefore
# not available to the client-side provider bundle, where it defaults to 1.
DEMO_TIMING_SCALE=1
