{
  "name": "@indago/platform",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/api/server.ts",
    "start": "node dist/api/server.js",
    "test": "vitest run --no-file-parallelism",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "build": "tsc",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@indago/contracts": "workspace:*",
    "@indago/entity-resolution": "workspace:*",
    "@indago/ingestion": "workspace:*",
    "@prisma/client": "^5.10.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}