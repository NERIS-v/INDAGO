PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=
# Redis
REDIS_URL=

# Durable artifact storage (content-addressed filesystem). Directory is created
# on first use; relative paths resolve against the platform package root.
ARTIFACT_STORAGE_DIR=.data/artifacts

# Legacy pipeline. The old `run-state` job is setwise-frozen; keep OFF. Enable
# ONLY during a documented transitional window with the legacy mirror running.
LEGACY_PIPELINE_ENABLED=false

# Integration/E2E tests (real Postgres). MUST point at a dedicated test
# database — never DATABASE_URL. Schema: `pnpm --filter @indago/platform db:push`
# with TEST_DATABASE_URL in the environment. Tests skip when unset.
TEST_DATABASE_URL=

# Security & Authentication (RBAC)
JWT_SECRET="indago-v7-dev-secret-key"

# UploadThing
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=
UPLOADTHING_INGEST_URL=https://ingest.uploadthing.com

# Auth token (shared with web package)
AUTH_TOKEN=