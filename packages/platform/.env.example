PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=
# Redis
REDIS_URL=
# BullMQ queue name. Default `investigation-pipeline`. Tests override this to
# a dedicated name so a running dev worker never steals their jobs.
# INVESTIGATION_QUEUE_NAME=

# Durable artifact storage (content-addressed filesystem). Directory is created
# on first use; relative paths resolve against the platform package root.
ARTIFACT_STORAGE_DIR=.data/artifacts

# Legacy pipeline. The old `run-state` job is setwise-frozen; keep OFF. Enable
# ONLY during a documented transitional window with the legacy mirror running.
LEGACY_PIPELINE_ENABLED=false

# Integration/E2E tests (real Postgres). MUST point at a dedicated test
# database — never DATABASE_URL. Schema: `pnpm --filter @indago/platform db:push`
# with TEST_DATABASE_URL in the environment. Tests skip when unset.
TEST_DATABASE_URL=

# Security & Authentication (RBAC)
JWT_SECRET="indago-v7-dev-secret-key"

# UploadThing. The SDK decodes appId/region/URL from UPLOADTHING_TOKEN
# automatically — do NOT set UPLOADTHING_INGEST_URL (it must match the token's
# region, e.g. <region>.ingest.uploadthing.com, and is only for self-hosting).
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=

# Auth token (shared with web package)
AUTH_TOKEN=

# === @indago/ai-agent-runtime (shared LLM execution infrastructure) ===
# Provider selection is EXPLICIT — no automatic fallback between providers.
#   AI_PROVIDER=ollama   → local Ollama generation (default, no key required)
#   AI_PROVIDER=gemini   → Gemini REST API (requires GEMINI_API_KEY)
# Placeholders only — never commit a real key. Copy to .env and fill in.
AI_PROVIDER=ollama
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# AI_DEFAULT_MODEL=