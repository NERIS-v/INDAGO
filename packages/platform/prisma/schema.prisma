datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector — required for the semantic embedding column (exact cosine distance).
  // Declared so migrations/db push provision the extension automatically.
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ============================================================================
// G-A04: Investigation Run State
// Maps exactly to @indago/contracts InvestigationRunStatus & State
// ============================================================================
model InvestigationRun {
  id              String   @id @default(uuid())
  investigationId String   @unique
  caseId          String
  status          String // QUEUED, INITIALIZING, RUNNING, PAUSED, COMPLETED, FAILED, CANCELLED
  state           String // CREATED, INGESTING, NORMALIZING, ANALYZING, DISCOVERING, WAITING_FOR_EVIDENCE, REASSESSING, REVIEW_REQUIRED, PAUSED, FAILED, COMPLETED
  currentStage    String? // Human readable sub-stage
  contextData     Json // Stores current knowns/gaps
  error           String?
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  checkpoints    AgentCheckpoint[]
  toolExecutions ToolExecution[]
}

// ============================================================================
// G-A05: Checkpoint Store for Resume/Replay
// ============================================================================
model AgentCheckpoint {
  id          String   @id @default(uuid())
  runId       String
  stepId      String
  stateHash   String
  toolResults Json?
  nextAction  String?
  timestamp   DateTime @default(now())

  run InvestigationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ============================================================================
// G-A07: Tool Execution Runtime
// ============================================================================
model ToolExecution {
  id         String   @id @default(uuid())
  runId      String
  toolId     String
  status     String // PENDING, RUNNING, COMPLETED, FAILED
  parameters Json
  output     Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  run InvestigationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ============================================================================
// G-A11: Append-Only Hash-Linked Audit Records
// ============================================================================
model AuditEvent {
  id              String   @id @default(uuid())
  investigationId String
  action          String
  actor           String // "AGENT", "SYSTEM", or "HUMAN:<ID>"
  targetType      String
  targetId        String
  description     String
  timestamp       DateTime @default(now())
  previousHash    String // Link to previous audit event
  hash            String   @unique // SHA-256(previousHash + actor + action + targetId + timestamp)
}

// ============================================================================
// P-01: Durable Artifact (M-PR1 persisted)
//
// artifactId is the deterministic case-scoped UUID (SHA-256 of
// "indago:artifact:v2:<caseId>:<contentHash>" → UUID v4-shaped), computed by
// @indago/ingestion. Artifact identity is scoped to (caseId, contentHash):
// the same bytes under different cases resolve to DIFFERENT rows. contentHash
// is unique only within a case (`@@unique([caseId, contentHash])`). Artifacts
// are NEVER keyed by fileKey, idempotencyKey, or provider fileHash.
//
// investigationId/caseId are plain indexed columns — no Prisma FK to
// InvestigationRun is declared so artifact records survive run rotations
// and the evidence ingestion path stays decoupled from the run lifecycle.
// ============================================================================
model Artifact {
  id               String   @id // deterministic UUID derived from (caseId, contentHash)
  contentHash      String // SHA-256 of artifact bytes (unique per case via composite below)
  storagePath      String
  detectedMimeType String
  declaredMimeType String?
  originalFilename String?
  contentSizeBytes Int
  sourceType       String?
  sourceId         String?
  investigationId  String
  caseId           String
  operationId      String
  correlationId    String
  idempotencyKey   String
  hashVerified     Boolean  @default(false)
  mimeVerified     Boolean  @default(false)
  providerMetadata Json?
  ingestedAt       DateTime @default(now())

  attempts       IngestionAttempt[]
  extractions    RawExtraction[]
  normalizations NormalizedExtraction[]

  @@unique([caseId, contentHash])
  @@index([investigationId])
  @@index([idempotencyKey])
}

// ============================================================================
// P-02: Durable Ingestion Attempt
//
// One row per logical evidence job (investigationId + idempotencyKey),
// updated across BullMQ retries. attemptNumber = job.attemptsMade + 1.
// Persisted failure state uses the canonical IngestionError JSON
// (category / code / message / retryable / sourceId / details) from
// @indago/contracts.
// ============================================================================
model IngestionAttempt {
  id              String   @id @default(uuid())
  investigationId String
  caseId          String
  idempotencyKey  String
  operationId     String
  correlationId   String
  attemptNumber   Int
  status          String // RUNNING, SUCCEEDED, FAILED
  sourceId        String?
  artifactId      String?
  parserId        String?
  parserVersion   String?
  format          String?
  error           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artifact      Artifact?             @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  extractions   RawExtraction[]
  normalization NormalizedExtraction?

  @@unique([investigationId, idempotencyKey])
  @@index([idempotencyKey])
  @@index([artifactId])
}

// ============================================================================
// P-03: Durable RawExtraction (M-PR3 persisted)
//
// Immutable per ingestion attempt. The full RawExtraction discriminated
// union (source locations + warnings + parserId/parserVersion) is stored as
// JSON; queryable columns mirror the provenance base fields. New parser/OCR
// version → new attempt → new row; the evidence trail is preserved.
// This table creates NO observations / entities / relations (pre-MA05).
// ============================================================================
model RawExtraction {
  id            String   @id @default(uuid())
  attemptId     String
  artifactId    String
  parserId      String
  parserVersion String
  format        String
  extraction    Json
  warnings      Json?
  extractedAt   DateTime

  attempt  IngestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  artifact Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([attemptId])
  @@index([artifactId, extractedAt])
}

// ============================================================================
// P-05: Durable NormalizedExtraction (M-A05 persisted)
//
// One row per ingestion attempt (attemptId @unique) — the canonical
// representative of the raw material. Stores the full NormalizedExtraction
// contract (versioned config + canonical fields + quality + lexical
// statistics) as JSON; queryable columns mirror provenance + engine identity.
// Normalization NEVER mutates the RawExtraction; a new normalizer version
// yields a new attempt → new row, preserving the evidence trail.
// This table creates NO observations / entities / relations (pre-MA06).
// ============================================================================
model NormalizedExtraction {
  id                String   @id @default(uuid())
  attemptId         String   @unique
  artifactId        String
  investigationId   String
  caseId            String
  normalizerId      String
  normalizerVersion String
  config            Json
  canonicalFields   Json
  quality           Json
  lexicalStatistics Json
  createdAt         DateTime @default(now())

  attempt  IngestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  artifact Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([artifactId, createdAt])
}

// ============================================================================
// P-06: Durable Source (M-A06 persisted)
//
// One deterministic Source row per ingested artifact's source seed. The
// catalog stores the platform-VALIDATED SourceCatalogSchema value; when the
// client-supplied declaration failed validation, catalog falls back to MANUAL
// and the ORIGINAL declaration is preserved verbatim in declaredCatalog so
// the fallback is fully auditable (never a silent drop).
// DOES NOT determine Observation strength (source catalog ≠ strength).
// ============================================================================
model Source {
  id              String   @id // deterministic SourceId (SHA-256 of investigationId:fileKey)
  caseId          String
  investigationId String
  catalog         String // validated SourceCatalogSchema value (FIR|CDR|FINANCIAL|…|MANUAL)
  declaredCatalog String? // original untrusted declaration preserved verbatim
  name            String // payload.sourceName
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence Evidence[]

  @@index([caseId])
  @@index([investigationId])
}

// ============================================================================
// P-07: Durable Evidence (M-A06 persisted)
//
// One row per (investigationId, operationId, artifactId). evidenceId is the
// deterministic SHA-256 → SHA-256-UUID of that triple — retry-safe and
// includes the stable submission/operation identity (edit #1). observedAt is
// the payload's declared real-world event time (never fabricated).
// ============================================================================
model Evidence {
  id                String   @id // deterministic EvidenceId (SHA-256(investigationId:operationId:artifactId))
  investigationId   String
  caseId            String
  operationId       String // stable batch identity — part of EvidenceId triple
  sourceId          String?
  sourceName        String
  sourceDescription String?
  evidenceType      String // EvidenceTypeSchema value
  title             String
  description       String?
  observedAt        Json? // EventTime (value + precision) from the submission
  artifactId        String
  createdAt         DateTime @default(now())

  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  observations Observation[]

  @@unique([investigationId, operationId, artifactId])
  @@index([caseId])
  @@index([sourceId])
}

// ============================================================================
// P-08: Durable Observation (M-A06 persisted)
//
// identityKey is the versioned canonical identity (buildObservationIdentityKey
// — evidenceId:sourceId:locationKey:type:canonicalContent) and is UNIQUE:
// the DB rejects exact-duplicate rows authored by concurrent/retried MA06
// passes. candidateMentions are lexical hints for MA07 — never entities.
// entityIds is ALWAYS [] in M-A06 (no entity linking here). Observations are
// content-verified by ObservationSchema on every read.
// ============================================================================
model Observation {
  id                String   @id // deterministic ObservationId (SHA-256 of identityKey)
  identityKey       String   @unique // versioned canonical identity — exact-dedup guard
  evidenceId        String
  sourceId          String
  investigationId   String
  caseId            String
  type              String // ObservationTypeSchema value
  content           String
  strength          Float
  candidateMentions Json // readonly string[] (≤50)
  provenance        Json // ProvenanceSchema
  observedAt        Json? // EventTime (only when unambiguous in content)
  eventTime         Json? // M-A12-D1: domain-valid EventTime when confidently extractable (never fabricated)
  sourceContextId   String? // M-A12-D2: lightweight source-context grouping key (NOT real-world event identity)
  validityInterval  Json? // M-A12-D5: closed [validFrom, validTo] TemporalInterval
  entityIds         Json // [] — MA06 never creates entity links
  createdAt         DateTime @default(now())

  evidence       Evidence                 @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  entityMentions EntityMentionCandidate[]

  @@index([investigationId, caseId])
  @@index([sourceId])
  @@index([evidenceId])
  @@index([sourceContextId])
  @@index([caseId, sourceContextId])
}

// ============================================================================
// P-08b: Durable EntityMentionCandidate (M-A07 persisted)
//
// identityKey is the versioned canonical identity
// (buildEntityMentionIdentityKey — observationId:start:end:entityType:
// canonicalMatchValue) and is UNIQUE: the DB rejects duplicate rows authored
// by concurrent/retried MA07 passes. id is the deterministic SHA-256 → UUID of
// that same key.
//
// M-A07 boundary: this table stores PRE-RESOLUTION entity-like mentions. It is
// NOT an Entity / EntityCandidate / EntityHypothesis and carries NO canonical
// EntityId or resolution score. Same textual name in different observations →
// separate candidates (resolution is a FUTURE stage). provenance is inherited
// verbatim from the parent Observation — never fabricated.
// ============================================================================
model EntityMentionCandidate {
  id                  String   @id // deterministic UUID (SHA-256 of identityKey)
  identityKey         String   @unique // versioned canonical identity — exact-dedup guard
  observationId       String
  investigationId     String
  caseId              String
  text                String
  start               Int
  end                 Int
  entityType          String? // EntityTypeSchema value or NULL (explicit uncertainty)
  extractionMethod    String // ExtractionMethodSchema value
  canonicalMatchValue String? // normalized matching value (distinct from text)
  provenance          Json // ProvenanceSchema (inherited from Observation)
  createdAt           DateTime @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  leftCandidatePairs  CandidatePair[] @relation("LeftCandidatePairs")
  rightCandidatePairs CandidatePair[] @relation("RightCandidatePairs")

  @@index([observationId])
  @@index([investigationId, caseId])
  @@index([entityType])
}

// ============================================================================
// P-08c: Durable CandidatePair (M-A08 multi-pass blocking — persisted)
//
// identityKey is the versioned canonical identity
// (buildCandidatePairIdentityKey — namespace:v1:caseId:minCandidateId:
// maxCandidateId) and is UNIQUE: the DB rejects duplicate rows authored by
// concurrent/retried MA08 passes, so a partial batch is recoverable (per-pair
// skipDuplicates, never a whole-batch gate). id is the deterministic SHA-256 →
// UUID of that same key.
//
// blockingPasses (Json) preserves EVERY blocking pass that discovered the pair
// (union semantics — ORDER-INDEPENDENT, deterministic). left/right candidate
// ids are canonical (min/max lexical) because the pair is UNORDERED.
//
// M-A08 boundary: this table stores a comparison UNIVERSE — pairs that are
// worth comparing, NOT resolved identities. It carries NO EntityId, NO
// ResolutionScore, NO hypothesis. Candidate↔Entity resolution is a FUTURE
// stage and is deliberately absent here.
// ============================================================================
model CandidatePair {
  id               String   @id // deterministic UUID (SHA-256 of identityKey)
  identityKey      String   @unique // versioned canonical identity — exact-dedup guard
  caseId           String
  investigationId  String?
  leftCandidateId  String
  rightCandidateId String
  blockingPasses   Json // non-empty, deterministic-ordered array of BlockingPass values
  createdAt        DateTime @default(now())

  leftCandidate    EntityMentionCandidate @relation("LeftCandidatePairs", fields: [leftCandidateId], references: [id], onDelete: Cascade)
  rightCandidate   EntityMentionCandidate @relation("RightCandidatePairs", fields: [rightCandidateId], references: [id], onDelete: Cascade)
  EntityHypothesis EntityHypothesis[]

  @@index([caseId])
  @@index([investigationId, caseId])
  @@index([leftCandidateId])
  @@index([rightCandidateId])
}

// ============================================================================
// P-09: Durable EntityHypothesis (M-A09 candidate↔candidate resolution)
//
// identityKey is the versioned canonical identity
// (buildEntityHypothesisIdentityKey — namespace:v1:candidatePairId:
// scoreModelVersion) and is UNIQUE: a candidatePairId + scoreModelVersion maps
// to exactly ONE logical hypothesis. id is the deterministic SHA-256 → UUID of
// that same key (deterministicEntityHypothesisId). A retry / concurrent pass
// converges to the same row — never a duplicate.
//
// M-A09 v1 semantic boundaries (enforced by the store + worker):
//   - Candidate↔Candidate only: caseId + candidatePairId are required;
//     entityId / resolvedEntityId are NULL (no canonical Entity fabricated).
//   - score / comparisonStatus / scoreModelVersion come verbatim from the
//     PURE resolver. The platform NEVER recalculates or re-weights them.
//   - status is the hypothesis LIFECYCLE state (PROPOSED at machine proposal;
//     ACCEPTED / REJECTED / REVERSED are authority/lifecycle states that a
//     re-resolution MUST NOT clobber).
//   - supportingObservationIds / contradictingObservationIds are stored as
//     bounded JSON arrays; their non-overlap is guaranteed by the resolver.
//
// No CandidateResolution table: CandidateResolution is a PURE intermediate
// engine result and is not persisted. Only CandidatePair (source) and
// EntityHypothesis (output) are durable in M-A09 v1.
// ============================================================================
model EntityHypothesis {
  id                          String   @id // deterministic UUID (SHA-256 of identityKey)
  identityKey                 String   @unique // versioned canonical identity — exact-dedup guard
  caseId                      String
  investigationId             String?
  candidatePairId             String
  entityId                    String? // canonical Entity (future) — NULL in v1 Candidate↔Candidate
  resolvedEntityId            String? // canonical Entity link (future) — NULL in v1
  status                      String // EntityResolutionStatusSchema lifecycle value
  comparisonStatus            String // EntityComparisonStatusSchema comparison value
  score                       Float // ResolutionScore ranging [0,1] — ranking signal only
  scoreModelVersion           String
  supportingCandidateIds      Json // EntityMentionCandidate IDs (positive identity evidence)
  supportingObservationIds    Json // Observation IDs providing positive identity evidence
  contradictingObservationIds Json // Observation IDs providing explicit contradiction evidence
  provenance                  Json // ProvenanceSchema
  metadata                    Json? // MetadataSchema (nullable)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  candidatePair CandidatePair @relation(fields: [candidatePairId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([investigationId, caseId])
  @@index([candidatePairId])
  @@index([status])
}

// ============================================================================
// P-09a: Durable Entity (canonical entity materialization)
//
// Canonical Entity is materialized ONLY through an explicit authority decision
// path: EntityHypothesis (PROPOSED) → explicit ACCEPTANCE → Entity.
//
// Entity.id is a deterministic UUID derived from a canonical identity key
// (namespace:v1:caseId:canonicalName:entityType). The same case+name+type
// converges to one logical entity — no duplicates.
//
// observationIds carries the Observation IDs linked to this entity (populated
// at materialization time from the accepting EntityHypothesis's
// supportingObservationIds). hypothesisIds records which EntityHypotheses
// reference this entity.
//
// M-A10 boundary: Entity provides the canonical EntityIds that RelationHypothesis
// endpoints reference. M-A10 NEVER fabricates Entity rows.
// ============================================================================
model Entity {
  id                String   @id // deterministic UUID (SHA-256 of identityKey)
  identityKey       String   @unique // versioned canonical identity — exact-dedup guard
  caseId            String
  investigationId   String?
  canonicalName     String   // best-known name for this entity
  entityType        String?  // EntityTypeSchema value (PERSON, ORGANIZATION, etc.)
  status            String   @default("ACTIVE") // CANDIDATE, ACTIVE, MERGED, SPLIT, ARCHIVED
  observationIds    Json     // ObservationId[] — observations linked to this entity
  hypothesisIds     Json     // EntityHypothesisId[] — hypotheses about this entity
  sourceIdentifiers Json?    // external source identifiers
  provenance        Json     // ProvenanceSchema
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([caseId])
  @@index([investigationId, caseId])
  @@index([status])
}

// ============================================================================
// P-10b: Durable RelationHypothesis (M-A10 relation resolution)
//
// identityKey is the versioned canonical identity
// (buildRelationHypothesisIdentityKey — namespace:v1:canonicalSource:
// canonicalTarget:relationType:scoreModelVersion) and is UNIQUE: the same
// entity pair + relation type + scoring model converges to ONE logical
// hypothesis. A retry / concurrent MA10 pass never duplicates.
//
// M-A10 v1 semantic boundaries (enforced by the store + worker):
//   - sourceEntityId / targetEntityId reference canonical Entity rows
//     (materialized from ACCEPTED EntityHypotheses). They are NEVER
//     EntityMentionCandidateIds or CandidatePairIds.
//   - support comes verbatim from the pure resolution engine. The platform
//     NEVER recalculates or re-weights it.
//   - status is the hypothesis LIFECYCLE state (PROPOSED at machine proposal;
//     ACCEPTED / REJECTED / REVERSED are authority/lifecycle states that a
//     re-resolution MUST NOT clobber).
//   - evidenceBasis / contradictions are stored as bounded JSON arrays of
//     Observation IDs; their semantics are guaranteed by the pure engine.
//   - scoreModelVersion records the scoring model for historical interpretability.
//
// REVERSED ≠ MERGED: reversal updates status + audit history; it does NOT
// delete the row. DELETION IS NEVER PERFORMED by this store.
//
// NO-FK DECOUPLING (intentional, harded-as-audited): sourceEntityId /
// targetEntityId reference canonical Entity.id but are declared as plain
// indexed String columns with NO Prisma @relation FK — mirroring the Artifact
// (lines 87-89) and Case (lines 591-593) decoupling precedent. The dangling-
// endpoint invariant is guaranteed STRUCTURALLY, not by a DB FK: every
// RelationHypothesis is proposed only by completeMA10 over
// entityStore.listByCaseWithObservations(caseId) — the durable canonical-entity
// universe (ARCHIVED excluded) — so a hypothesis is NEVER created against a
// missing/mention/pair endpoint. Adding a Prisma FK here would single out
// Relations/RelationHypotheses from every other FK-free model and break the
// uniform decoupling stance.
// ============================================================================
model RelationHypothesis {
  id                String   @id // deterministic UUID (SHA-256 of identityKey)
  identityKey       String   @unique // versioned canonical identity — exact-dedup guard
  caseId            String
  investigationId   String?
  sourceEntityId    String   // canonical Entity.id — NEVER a mention/pair ID
  targetEntityId    String   // canonical Entity.id — NEVER a mention/pair ID
  relationType      String   // RelationTypeSchema value
  support           Float    // RelationSupport [0,1] — ranking signal, NOT probability
  evidenceBasis     Json     // ObservationId[] — supporting observations
  contradictions    Json     // ObservationId[] — contradicting observations (may be [])
  status            String   // RelationStatusSchema lifecycle value
  scoreModelVersion String   // scoring model version for interpretability
  evidenceCount     Int      @default(0)
  evidenceStrength  Float    @default(0)
  sourceCoverage    Float    @default(0)
  temporalCoverage  Float    @default(0)
  directed          Boolean  @default(true)
  validityInterval  Json? // M-A12-D5: proposed closed [validFrom, validTo] TemporalInterval
  temporalAssertions Json? // M-A12: assertion records for future interval amendments (RELATION_AMENDED)
  provenance        Json     // ProvenanceSchema
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([caseId])
  @@index([investigationId, caseId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([status])
  @@index([relationType])
}

// ============================================================================
// Canonical Relation (M-A10 relation authority)
//
// The explicit outcome of an ACCEPTED RelationHypothesis — the canonical
// relation that the Graphology projection consumes. Nothing auto-magically
// becomes a canonical Relation: this row is created ONLY through the explicit
// relation-authority accept path (relation-materialization), mirroring how a
// canonical Entity is created only through entity-materialization.
//
//   RelationHypothesis (PROPOSED) --accept--> Canonical Relation
//
// Idempotency: relationKey @unique maps one (source, target, relationType,
// directed, model) to exactly one canonical relation. A reversal records
// REVERSED; it does not delete the row (REVERSED != MERGED).
//
// NO-FK DECOUPLING (intentional): sourceEntityId / targetEntityId reference
// canonical Entity.id as plain indexed String columns with NO Prisma @relation
// FK — same deliberate stance as RelationHypothesis, Artifact, and Case above.
// Endpoint integrity is guaranteed structurally: a canonical Relation is
// materialized ONLY from an ACCEPTED RelationHypothesis (whose endpoints were
// themselves proposed over the durable canonical-entity universe), never from a
// dangling / mention / pair id.
// ============================================================================
model Relation {
  id                String  @id // deterministic UUID (SHA-256 of relationKey)
  relationKey       String  @unique // versioned canonical identity — exact-dedup guard
  caseId            String
  investigationId   String?
  sourceEntityId    String  // canonical Entity.id — NEVER a mention/pair ID
  targetEntityId    String  // canonical Entity.id — NEVER a mention/pair ID
  relationType      String  // RelationTypeSchema value
  directed          Boolean // authoritative directionality of the relation type
  support           Float   // retained for provenance; NOT required for projection
  evidenceBasis     Json    // ObservationId[] — supporting observations
  contradictions    Json    // ObservationId[] — contradicting observations (may be [])
  status            String  @default("ACTIVE") // ACTIVE / REVERSED
  scoreModelVersion String
  evidenceCount     Int     @default(0)
  provenance        Json    // ProvenanceSchema — links back to the accepted hypothesis
  hypothesisId      String  // the source RelationHypothesis that was accepted
  validityInterval  Json? // M-A12-D5: closed [validFrom, validTo] TemporalInterval (inherited from accepted hypothesis)
  temporalAssertions Json? // M-A12: assertion records for future interval amendments (RELATION_AMENDED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reversedAt        DateTime?

  @@index([caseId])
  @@index([investigationId, caseId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([status])
  @@index([relationType])
}

// ============================================================================
// M-A12-D6: Append-only TemporalStateChange history (PR1)
//
// An append-only record of canonical state transitions carrying domain/event
// time, ingestion time, and system transaction time, so canonical temporal
// state is reconstructable INDEPENDENT of the mutable current rows (D6).
//
// Invariants:
//   - append-only: rows are never updated or deleted once written.
//   - deterministic ordering: each (caseId, entityType, entityId) gets a
//     monotonically increasing `sequence`; `@@unique([caseId, entityType,
//     entityId, sequence])` guarantees the DB rejects duplicates and gives a
//     stable reconstruction order (§10). Sequence is allocated by the store
//     application-side (max(existing)+1), not by the DB, so reconstruction is
//     deterministic across replays.
//   - `eventTime` / `validityInterval` / `provenance` are the same vocabulary
//     used on Observation/Relation (D3); when a transition carries domain time
//     it is recorded here, never fabricated.
//   - `transactionTime` distinguishes system-write time from `eventTime`
//     (D1). `ingestedAt` records when the underlying evidence was ingested.
//   - `stateType` is the canonical lifecycle transition (CREATED / ACCEPTED /
//     REVERSED / UPDATED / ...).
//
// No graph version coupling (D7): this table is NOT a GraphVersion snapshot.
// GraphVersion is deliberately deferred to PR2.
//
// NO-FK DECOUPLING (intentional, consistent with the rest of the schema):
// caseId / entityId are plain indexed Strings, not Prisma FKs, so history rows
// survive and remain reconstructable even where the entity rows are replaced.
// ============================================================================
model TemporalStateChange {
  id                String   @id // deterministic UUID (SHA-256 of caseId:entityType:entityId:sequence)
  logicalKey        String?  @unique // exact-duplicate guard: caseId:entityType:entityId:stateType[:eventRef]
  caseId            String
  investigationId   String?
  entityType        String // canonical entity kind: OBSERVATION | ENTITY | RELATION | RELATION_HYPOTHESIS | ...
  entityId          String // the canonical entity's deterministic id
  stateType         String // lifecycle transition (CREATED / ACCEPTED / REVERSED / UPDATED / ...)
  sequence          Int      // monotonic per (caseId, entityType, entityId)
  eventTime         Json? // M-A12-D1: domain/event time associated with this transition (may be null)
  validityInterval  Json? // M-A12-D5: closed [validFrom, validTo] TemporalInterval (may be null)
  provenance        Json? // M-A12-D2: lineage back to the source observation/extraction
  ingestedAt        DateTime? // when the underlying evidence was ingested
  transactionTime   DateTime @default(now()) // system write time (distinct from eventTime, D1)
  note              String?
  createdAt         DateTime @default(now())

  @@unique([caseId, entityType, entityId, sequence])
  @@index([caseId, sequence])
  @@index([caseId, entityType, entityId])
  @@index([entityId])
}

// ============================================================================
// P-10c: Durable Case (case catalogue — dashboard)
//
// One row per case boundary the platform has ever seen. Rows are
// auto-provisioned (create-or-nothing, id = caseId) when an investigation run
// is created (POST /investigations/start) and reconciled on read
// (GET /api/v1/cases) so pre-existing runs surface immediately.
//
// title / status / assignedTo carry platform-owned STANDARD defaults because
// the canonical CaseSchema makes them mandatory and no case-creation/edit flow
// exists yet — these are explicit persisted values, never invented per
// response. investigationIds / evidenceIds / entityIds are DERIVED at read time
// from durable run/evidence/observation rows — never stored denormalized.
//
// No Prisma FK is declared (caseId on InvestigationRun / Artifact / Source /
// Evidence / Observation is a plain indexed column) so the case catalogue stays
// decoupled from the run lifecycle, mirroring the Artifact decoupling comment.
// ============================================================================
model Case {
  id           String    @id // canonical case ID == InvestigationRun.caseId
  title        String
  description  String?
  status       String    @default("OPEN") // OPEN, ACTIVE, CLOSED, ARCHIVED
  assignedTo   String
  jurisdiction String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?
}

// ============================================================================
// M-A12 D4: Durable GraphVersion (PR2 — graph versioning foundation)
//
// A GraphVersion is the logical-revision record for a case's canonical graph.
// It is PERSISTED in PostgreSQL (authoritative) and drives the historical
// graph projection; Graphology remains a DERIVED, disposable in-memory
// projection rebuilt from this + the canonical domain records (§12).
//
// Identity semantics (D4, locked):
//   id = RANDOM UUID (repository row-ID convention — the contract's
//        GraphVersionIdSchema: z.string().uuid()). It is deliberately NOT a
//        content hash. Deterministic logical identity is the natural key
//        (caseId, versionNumber); "same history + same boundary ⇒ same
//        versionNumber sequence ⇒ same projected graph" comes from replay
//        determinism, never from hashing canonical content into the id.
//
// Version numbering (§ version-numbering):
//   versionNumber is case-scoped, monotonically increasing, never reused,
//   persisted, and allocated as MAX(versionNumber)+1 INSIDE an interactive
//   transaction, SERIALIZED PER CASE by a transaction-scoped PostgreSQL
//   advisory lock (pg_advisory_xact_lock(hashtextextended(caseId,0))). Two
//   simultaneous canonical changes for the same case therefore BLOCK until the
//   in-flight allocation commits and can never compute the same — or silently
//   share a — versionNumber. @@unique([caseId, versionNumber]) is retained as a
//   hard safety invariant, not the primary concurrency mechanism (STOP #4
//   satisfied).

//
// Lifecycle (D4, § graph version lifecycle):
//   status ∈ DRAFT | ACTIVE | SUPERSEDED | ARCHIVED with the locked legal
//   transitions DRAFT→ACTIVE, ACTIVE→SUPERSEDED, SUPERSEDED→ARCHIVED enforced
//   by GraphVersionStore (no arbitrary transitions; append-only — a version is
//   never mutated except a permitted lifecycle transition + projection-status /
//   node/edge-count updates).
//
// Lineage (parentGraphVersionId):
//   immediate parent in the same case, versionNumber < child, no cycles,
//   linear (non-branching) — validated by the store (§ parent versioning).
//
// projectionStatus:
//   runtime status of the authoritative materialization step. `PENDING` means
//   the version exists but has not been projected; the subset of the contract
//   enum { COMPLETE, PARTIAL, STALE, ERROR } applies once projection has run.
//   A failed projection is recoverable (retry is idempotent) and never silently
//   marked COMPLETE.
//
// NO-FK DECOUPLING (intentional, consistent with the rest of the schema):
//   caseId / investigationId / parentGraphVersionId / checkpointId are plain
//   indexed columns with NO Prisma @relation FK — mirroring Artifact, Case,
//   Relation, RelationHypothesis. A GraphVersion must outlive run rotations,
//   hypothesis replacements and checkpoint lifecycle; checkpoint ↔ version
//   reverse coupling is explicitly PR3 (D7) and must not force an FK here.
//
// createdAt / updatedAt are SYSTEM timestamps — never the graph's effective
// temporal boundary (§4 rule I/J).
// ============================================================================
model GraphVersion {
  id                 String   @id @default(uuid()) // random UUID (D4)
  caseId             String // explicit case scope
  investigationId    String?
  versionNumber      Int // monotonic, case-scoped, never reused
  status             String   @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED | ARCHIVED
  parentGraphVersionId String? // immediate parent in the same case
  projectionStatus   String   @default("PENDING") // PENDING | COMPLETE | PARTIAL | STALE | ERROR
  nodeCount          Int      @default(0)
  edgeCount          Int      @default(0)
  checkpointId       String? // preserved contract field — reverse coupling is PR3 (D7)
  reason             String? // human/audit reason for this version (canonical change that created it)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([caseId, versionNumber]) // natural key — D4 determinism + concurrent-allocation guard
  @@index([caseId, versionNumber]) // case-scoped listing + natural-key lookup
  @@index([caseId, status]) // lifecycle/active-version lookups
  @@index([caseId, projectionStatus]) // projection-status recovery queries
  @@index([parentGraphVersionId]) // lineage traversal
}

// ============================================================================
// P4 — InvestigativeLead (backend lifecycle)
//
// A Lead is the Phase-4 investigation-loop record produced by interpreting a
// structural/temporal candidate (bridge / temporal burst / community /
// cross-case match — @indago/graphology-projection, @indago/lead-generation)
// into a line of inquiry a human can review. Leads are STRUCTURAL SIGNALS,
// never verdicts: `confidence` is analytical confidence the lead is worth
// pursuing, NOT a probability of guilt (see contracts/common/confidence.ts).
//
// Identity: id = deterministic UUID derived from
// (caseId, sourceCandidateType, sourceCandidateKey) via
// @indago/lead-generation's buildLeadIdentityKey — re-running generation over
// an unchanged candidate reproduces the SAME lead id (idempotent upsert,
// matching the identity-key discipline used everywhere else in this schema:
// Relation.relationKey, GraphVersion natural key, etc.) rather than minting
// duplicate leads on every generation pass.
//
// status lifecycle (LeadStore-enforced, mirrors GraphVersionStore's
// no-arbitrary-transitions discipline):
//   NEW -> UNDER_REVIEW -> ACTIVE -> { PROMOTED | REJECTED | STALE }
//   NEW -> REJECTED (fast reject without review)
//   Any of {UNDER_REVIEW, ACTIVE} -> STALE (goes stale from inactivity)
// Terminal: PROMOTED, REJECTED, STALE never transition further.
//
// alternativeExplanations (Json array of AlternativeExplanationSchema) are
// generated alongside the lead by @indago/lead-generation — every P4 lead
// ships with at least one non-incriminating alternative reading of the same
// structural signal (Phase 6/9 discipline: structural signal != criminal
// relevance; alternatives must be surfaced for high-impact leads).
//
// NO-FK DECOUPLING (intentional, consistent with the rest of the schema):
// caseId/investigationId/entity & observation id arrays are plain
// indexed/Json columns, not Prisma FKs — mirroring Relation, Entity, etc.
// ============================================================================
model Lead {
  id                        String    @id // deterministic UUID — see identity note above
  caseId                    String
  investigationId           String?
  title                     String
  description               String
  status                    String    @default("NEW") // NEW | UNDER_REVIEW | ACTIVE | PROMOTED | REJECTED | STALE
  priority                  String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  confidence                Float     // AnalyticalConfidenceSchema — NOT a probability unless calibrated
  posture                   String    // EvidencePostureSchema tier
  relatedEntityIds          Json      // EntityId[]
  supportingObservationIds  Json      // ObservationId[] — evidence FOR
  contradictingObservationIds Json    @default("[]") // ObservationId[] — evidence AGAINST
  relatedEvidenceIds        Json      @default("[]") // EvidenceId[]
  gapIds                    Json      @default("[]") // InvestigativeGapId[]
  sourceCandidateType       String    // BRIDGE | TEMPORAL_BURST | COMMUNITY | CROSS_CASE
  sourceCandidateKey        String    // deterministic identity key of the originating candidate (see lead-generation)
  sourceCandidateSnapshot   Json      // the candidate payload at generation time, for audit/explainability
  alternativeExplanations   Json      @default("[]") // AlternativeExplanationSchema[]
  provenance                Json      // ProvenanceChainSchema
  assignedTo                String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  closedAt                  DateTime?

  @@index([caseId])
  @@index([investigationId, caseId])
  @@index([caseId, status])
  @@index([sourceCandidateType])
}

// ============================================================================
// P4 — LeadEvidenceLink (dedicated evidence FOR/AGAINST attach surface)
//
// The Phase-4 tracker gap this closes: Entity/RelationHypothesis already
// persist supporting/contradicting observation sets, but there was no
// DEDICATED attach API or verdict record at the Lead level. This table is
// that dedicated surface: one row per (lead, observation) verdict, with the
// human/system rationale for the attach kept alongside it (never silently
// folded into the raw id arrays on Lead — those stay a denormalized summary,
// this table is the source of truth for "why").
//
// verdict is FOR or AGAINST ONLY — this is an evidentiary relevance verdict,
// never a truth/guilt verdict (same discipline as everywhere else: role !=
// culpability, structural signal != criminal relevance).
// ============================================================================
model LeadEvidenceLink {
  id             String   @id @default(uuid())
  leadId         String
  observationId  String
  verdict        String   // FOR | AGAINST
  rationale      String?
  addedBy        String
  createdAt      DateTime @default(now())

  @@unique([leadId, observationId, verdict]) // idempotent re-attach guard
  @@index([leadId])
  @@index([observationId])
}

// ============================================================================
// P4 — LeadEvent (append-only lead provenance / audit trail)
//
// Mirrors TemporalStateChange's append-only discipline (D6) at the Lead
// level: every material change to a Lead (creation, evidence attach, status
// transition, alternative-explanation addition) is recorded here as an
// immutable row, so a lead's full history is reconstructable independent of
// its current (mutable) row — this is the "Persist lead provenance" Phase-4
// deliverable, distinct from the evidentiary ProvenanceChain stored inline
// on Lead.provenance (that traces evidence lineage; this traces the lead
// RECORD's own lifecycle).
// ============================================================================
model LeadEvent {
  id        String   @id @default(uuid())
  leadId    String
  caseId    String
  eventType String   // LEAD_CREATED | EVIDENCE_ATTACHED | STATUS_CHANGED | ALTERNATIVE_EXPLANATION_ADDED
  actor     String
  payload   Json
  sequence  Int      // monotonic per leadId, application-allocated (max(existing)+1) — deterministic replay order
  createdAt DateTime @default(now())

  @@unique([leadId, sequence])
  @@index([leadId])
  @@index([caseId])
}
// Phase 5A-PR1.5: Semantic embedding + retrieval (pgvector)
//
// SemanticTextUnit is the ATOMIC retrievable text item. It is a MUTABLE CURRENT
// RETRIEVAL PROJECTION, not immutable historical text identity: the same
// (caseId, sourceType, sourceId) row is UPDATED IN PLACE when the source text
// changes. It carries NO truth value and NO evidence authority: it is a
// recall/context layer, never a conclusion and never the authority for
// entity/relation resolution (M-A09/M-A10 stay authoritative). No version
// history is kept — a changed source simply has a new contentHash.
//
// Identity model (single source of truth):
//   - SemanticTextUnit identity = caseId + sourceType + sourceId
//     (@@unique([caseId, sourceType, sourceId]) bounds ONE row per source
//     object; "shared content" under the SAME triple is the SAME unit).
//   - Current text version = contentHash (SHA-256 of canonicalized text).
//     Upserting a changed source updates normalizedText + contentHash IN PLACE.
//   - Embedding freshness: an embedding row is CURRENT for a unit iff
//     embedding.contentHash === semanticTextUnit.contentHash; anything else is
//     STALE and excluded from search by the freshness join.
//   - temporalScope = optional M-A12 TemporalInterval of the source claim;
//     retrieval filters on it IN SQL (never in application memory).
//
// SemanticEmbedding stores the learned vector for a unit under an EXPLICIT
// provider identity (providerId + modelId + modelVersion) + embedding policy
// version. @@unique([semanticTextUnitId, providerId, modelId, modelVersion,
// embeddingPolicyVersion]) means:
//   - one provider slot per unit (a provider swap never mixes vectors)
//   - a policy bump yields a NEW version, never a silent overwrite of history
//
// V1 DIMENSION CONSTRAINT: the `vector` column is FIXED at vector(768) because
// the active Ollama production provider is nomic-embed-text:latest. Future
// cloud providers MUST use 768-dimensional embeddings until a future storage
// migration introduces dimension-specific storage. The provider identity keeps
// carrying dimensions so incompatible vectors are STILL rejected at validation.
//
// The `vector` column is UNSUPPORTED to Prisma (vector(768)) and is therefore
// written/read ONLY through parameterized raw SQL inside the repositories —
// never through the typed client. V1 ships NO ANN index: retrieval is EXACT
// cosine distance ordering (ORDER BY distance ASC, unit id ASC); ANN/HNSW is
// deferred until dataset scale + an identity-aware filtering/index strategy.
// ============================================================================
model SemanticTextUnit {
  id             String   @id // durable row id (deterministic; identity = caseId+sourceType+sourceId, see header)
  caseId         String
  sourceType     String // SemanticSourceTypeSchema value
  sourceId       String // canonical id of the source domain object
  contentHash    String // SHA-256 of normalizedText — CURRENT text version; embedding freshness key
  normalizedText String
  temporalScope  Json? // M-A12 TemporalInterval or NULL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  embeddings SemanticEmbedding[]

  @@unique([caseId, sourceType, sourceId])
  @@index([caseId])
  @@index([contentHash])
}

model SemanticEmbedding {
  id                     String   @id // deterministic UUID of the identity key
  semanticTextUnitId     String
  caseId                 String
  contentHash            String // snapshot of the unit hash at embed time
  providerId             String
  modelId                String
  modelVersion           String
  dimensions             Int
  embeddingPolicyVersion String // v1 — embedding policy version
  vector                 Unsupported("vector(768)")? // never touched by the typed client
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  textUnit SemanticTextUnit @relation(fields: [semanticTextUnitId], references: [id], onDelete: Cascade)

  @@unique([semanticTextUnitId, providerId, modelId, modelVersion, embeddingPolicyVersion])
  @@index([caseId, providerId, modelId, modelVersion, embeddingPolicyVersion])
}

// ============================================================================
// Phase 5A-PR6: GraphHole intelligence persistence (identity, persistence,
// deduplication, idempotency, concurrency safety, ownership, supersession).
//
// These four models are the SINGLE authoritative persistence boundary for the
// deterministic PR4/PR5 pipeline. They persist INTELLIGENCE FINDINGS only —
// never investigation workflow state (that stays with Lead / InvestigationRun).
//
// Identity discipline (mirrors the repo-wide identityKey convention):
//   - regionId / candidateId are SHA-256 of the canonical identity string
//     (computed by @indago/graph-hole-region / @indago/graph-hole-detection).
//   - identityKey @unique stores the canonical identity STRING (exact-dedup
//     guard — "the DB rejects duplicate rows, never SELECT-then-INSERT").
//   - id is a random UUID RECORD id, deliberately distinct from the domain
//     candidateId (same stance as GraphVersion, whose natural key is
//     (caseId, versionNumber)).
//
// scoringPolicyVersion is persisted METADATA only — it is deliberately NOT
// part of candidate identity (see graph-hole-candidate.ts / graph-hole-
// persistence.ts contracts).
//
// NO-FK DECOUPLING (intentional, consistent with the rest of the schema):
// caseId / graphVersionId / regionId / supersedesGraphHoleId are plain
// indexed columns, not Prisma FKs. GraphHoleDetectorContribution and
// GraphHoleAssessment ARE strict children of GraphHole and carry a Prisma FK
// (GraphHole is never deleted, so cascade semantics are inert; the FK mirrors
// EntityMentionCandidate → Observation).
// ============================================================================

// ============================================================================
// P-GH-1: Durable RegionAnalysis (no-repeat behavior + traceability)
//
// Stores only the BOUNDED region facts required for no-repeat, reassessment,
// historical traceability, and policy/version awareness. Deliberately NO graph
// payloads (region identity already content-addresses the full node/edge/seed
// context via the canonical region identity).
// ============================================================================
model GraphHoleRegionAnalysis {
  id                             String   @id @default(uuid()) // record id (domain id = regionId hex)
  identityKey                    String   @unique // canonical region identity string — exact-dedup guard
  regionId                       String // SHA-256 hex of the canonical region identity
  caseId                         String
  investigationId                String?
  graphVersionId                 String
  regionPolicyVersion            String // GRAPH_HOLE_POLICY_VERSION
  semanticRetrievalPolicyVersion String // SEMANTIC_RETRIEVAL_POLICY_VERSION
  status                         String // RegionStatusSchema: SATURATED | LIMITED | DEGRADED
  truncated                      Boolean  @default(false)
  seedObservationIds             Json // sorted unique ObservationId[]
  nodeIds                        Json // sorted unique GraphNodeId[]
  edgeIds                        Json // sorted unique GraphEdgeId[]
  temporalContext                Json? // TemporalInterval or NULL
  summary                        Json? // bounded RegionAnalysisSummary (see store)
  analyzedAt                     DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@unique([regionId, caseId, graphVersionId, regionPolicyVersion]) // DB-enforced composite identity
  @@index([caseId])
  @@index([caseId, graphVersionId])
  @@index([graphVersionId])
}

// ============================================================================
// P-TR-1: Durable TargetedReblockRun (Phase 5A-PR11)
//
// One authoritative row per targeted reblock execution identity. Stores only
// the bounded run facts (identity, accounting, counts, provenance) — never the
// candidate graph (the run identity content-addresses the selected candidates).
// runId = SHA-256 hex of identityKey; the DB unique constraint is the
// duplicate-prevention mechanism, never SELECT-then-INSERT.
// ============================================================================
model TargetedReblockRun {
  id                  String   @id @default(uuid()) // record id (domain id = runId hex)
  runId               String   @unique // SHA-256 hex of the canonical run identity
  identityKey         String   @unique // canonical run identity string — exact-dedup guard
  caseId              String
  investigationId     String?
  graphVersionId      String
  regionId            String // producing region.regionId (targeted scope)
  regionPolicyVersion String // GRAPH_HOLE_POLICY_VERSION of the persisted region
  policyVersion       String   @default("v1") // TARGETED_REBLOCK_POLICY_VERSION
  requestedAt         DateTime // clock-resolved run request time
  accounting          Json // TargetedReblockAccountingSchema
  counts              Json // TargetedReblockCountsSchema
  provenance          Json // TargetedReblockProvenanceSchema
  truncated           Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([caseId, graphVersionId])
  @@index([regionId])
}

// ============================================================================
// P-GH-2: Durable GraphHole (authoritative current intelligence finding)
// ============================================================================
model GraphHole {
  id                         String   @id @default(uuid()) // RECORD id — never the domain candidateId
  identityKey                String   @unique // canonical candidate identity string — exact-dedup guard
  candidateId                String // SHA-256 hex of the canonical candidate identity
  caseId                     String
  investigationId            String?
  graphVersionId             String
  regionId                   String // producing region.regionId (content-addressed)
  holeType                   String // GraphHoleTypeSchema value
  canonicalNodeIds           Json // sorted unique GraphNodeId[]
  expectedRelationshipType   String? // RelationTypeSchema or NULL
  temporalScope              Json? // TemporalInterval or NULL
  detectionPolicyVersion     String // DETECTION_POLICY_VERSION
  scoringPolicyVersion       String // GRAPH_HOLE_SCORING_POLICY_VERSION (METADATA, not identity)
  qualificationPolicyVersion String // GRAPH_HOLE_POLICY_VERSION (qualification-policy schema version)
  status                     String   @default("ACTIVE") // GraphHolePersistenceStatusSchema
  structuralScore            Float
  evidenceSupportScore       Float
  expectedInformationValue   Float
  significance               Float
  supersedesGraphHoleId      String? // lineage to the prior-version record of the same logical hole (plain column)
  supersededAt               DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  contributions GraphHoleDetectorContribution[]
  assessments   GraphHoleAssessment[]

  @@unique([caseId, candidateId]) // case-scoped identity uniqueness (DB-enforced)
  @@index([caseId, status])
  @@index([graphVersionId])
  @@index([regionId])
}

// ============================================================================
// P-GH-3: Durable detector contributions (multi-detector deduplication)
//
// One row per (graphHoleId, detectorType, detectionPolicyVersion). Multiple
// detectors converging on the same candidate coexist here; the first
// detector's provenance is never overwritten by a later detector.
// ============================================================================
model GraphHoleDetectorContribution {
  id                            String   @id @default(uuid())
  identityKey                   String   @unique // buildDetectorContributionIdentityKey — exact-dedup guard
  graphHoleId                   String
  caseId                        String
  candidateId                   String // parent candidateId (queryability, case-scoped audit)
  detectorType                  String // GraphHoleTypeSchema value
  detectionPolicyVersion        String // DETECTION_POLICY_VERSION consumed by THIS detector
  structuralBasis               String // StructuralBasisSchema value
  supportingHypothesisIds       Json // PR3 hypothesis ids (sorted unique)
  supportingObservationIds      Json // ObservationId[] (sorted unique)
  contradictingObservationIds   Json // ObservationId[] (sorted unique)
  observedEdgeIds               Json // GraphEdgeId[] (sorted unique)
  detectorMetadata              Json // GraphHoleDetectorMetadataSchema
  provenance                    Json // ProvenanceSchema — first-detector provenance preserved
  createdAt                     DateTime @default(now())

  graphHole GraphHole @relation(fields: [graphHoleId], references: [id], onDelete: Cascade)

  @@unique([graphHoleId, detectorType, detectionPolicyVersion])
  @@index([caseId])
  @@index([candidateId])
}

// ============================================================================
// P-GH-4: Append-only GraphHole assessment history (LeadEvent/TemporalStateChange
// discipline)
//
// One row per assessment/state event, monotonic `sequence` per graphHoleId
// (app-side max+1), `logicalKey @unique` dedups identical re-runs. `snapshot`
// preserves the exact qualified output of each assessment so old analysis
// remains queryable after the current row mutates.
// ============================================================================
model GraphHoleAssessment {
  id                            String   @id @default(uuid())
  graphHoleId                   String
  caseId                        String
  sequence                      Int // monotonic per graphHoleId — app-side max+1
  logicalKey                    String?  @unique // dedup of identical re-runs (null for state events)
  assessmentType                String // GraphHoleAssessmentTypeSchema
  status                        String // GraphHolePersistenceStatusSchema value at event time
  graphVersionId                String
  detectionPolicyVersion        String
  scoringPolicyVersion          String
  qualificationPolicyVersion    String
  snapshot                      Json // qualified output (assessment) or current-state summary (state event)
  reason                        String?
  createdAt                     DateTime @default(now())

  graphHole GraphHole @relation(fields: [graphHoleId], references: [id], onDelete: Cascade)

  @@unique([graphHoleId, sequence])
  @@index([graphHoleId])
  @@index([caseId])
}

// ============================================================================
// Phase 5A-PR12 — Incremental Graph-Hole Reassessment (ordered change ledger)
//
// One durable row per authoritative change that may affect graph-hole
// intelligence. `changeId` is the deterministic SHA-256 of the canonical change
// identity (canonicalizeReassessmentChangeIdentity) and is UNIQUE — the DB
// constraint, not SELECT-then-INSERT, is the duplicate-prevention mechanism
// (duplicate publication / crash-then-rerun is an idempotent no-op).
//
// `sequence` is a per-case monotonic order allocated under a transaction-scoped
// PostgreSQL advisory lock (mirroring GraphVersion allocation). The worker
// drains PENDING changes in canonical sequence order, coalesces deterministically,
// resolves the affected set, executes the plan, records the per-change outcome,
// and advances the per-case CaseReassessmentCursor. A change whose own
// processing partially/fully failed is recorded PARTIAL/FAILED before the cursor
// advances — the cursor never claims failed work was fully applied. FAILED is
// terminal for a changeId (a fresh REASSESSMENT_REQUESTED may re-open it).
//
// No FK is declared (caseId / graphVersionId are plain indexed columns),
// consistent with the rest of the schema's no-FK decoupling doctrine.
// ============================================================================
model CaseReassessmentChange {
  id                   String    @id @default(uuid())
  caseId               String
  graphVersionId       String? // the ACTIVE version the change was evaluated on
  sequence             Int // per-case monotonic (max+1, advisory-locked)
  changeId             String    @unique // deterministic change identity — dedup guard
  trigger              Json // ReassessmentTriggerSchema (zod-validated)
  effectClass          String // EVIDENCE_AFFECTING | GRAPH_AFFECTING | MANUAL_REASSESSMENT
  status               String    @default("PENDING") // PENDING | COMPLETED | PARTIAL | FAILED | SKIPPED
  attemptCount         Int       @default(0)
  failureReason        String?
  processedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([caseId, sequence])
  @@index([caseId, sequence])
  @@index([caseId, status])
  @@index([graphVersionId])
}

// ============================================================================
// PR12 — per-case reassessment watermark
//
// `lastProcessedSequence` names the highest change sequence fully accounted.
// TemporalStateChange.sequence is per (caseId, entityType, entityId) and is NOT
// an acceptable global cursor — this dedicated per-case cursor is authoritative.
// ============================================================================
model CaseReassessmentCursor {
  caseId                  String   @id
  lastProcessedSequence   Int      @default(0)
  updatedAt               DateTime @updatedAt
  policyVersion           String   @default("v1") // PR12_REASSESSMENT_POLICY_VERSION
}

// ============================================================================
// PR12 — per-change reassessment run outcome (append-only audit)
//
// One row per COMPLETED/PARTIAL run executing an incremental reassessment plan
// for a change. runId is a deterministic UUID; the row records the frozen
// IncrementalReassessmentRun envelope (affectedSet, plan, regionResults,
// accounting, status) plus the per-case sequences it covered (cursorBefore/
// cursorAfter) for exact auditability.
// ============================================================================
model ReassessmentRun {
  id                 String   @id @default(uuid())
  runId              String   @unique
  caseId             String
  investigationId    String?
  changeId           String
  sequence           Int // the change sequence this run accounts for
  graphVersionId     String
  policyVersion      String   @default("v1")
  envelope           Json // IncrementalReassessmentRunSchema (zod-validated)
  cursorBefore       Int
  cursorAfter        Int
  createdAt          DateTime @default(now())

  @@index([caseId, sequence])
  @@index([changeId])
